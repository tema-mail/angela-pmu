import Services from '../components/Services.astro';
import PortfolioSection from '../components/PortfolioSection.astro';
import About from '../components/About.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import Contacts from '../components/Contacts.astro';
---
<Base
  title="Перманентный макияж и микроблейдинг в Севастополе – Анжела Богатырёва"
  description="Топ-мастер перманентного макияжа и микроблейдинга в Севастополе: акварельные губы, напыление бровей и межресничного пространства. Более 10 000 процедур, естественный результат."
>
  <Header />
  <main>
    <Hero />
    <Services />
    <PortfolioSection />
    <About />
    <ReviewsSection />
    <Contacts />
  </main>
</Base>
